# Copiar este archivo como .env.local y llenar con los valores reales.
# .env.local NO se sube al repositorio.

# Cadena de conexión de Supabase: Project Settings -> Database ->
# Connection string -> "Transaction pooler" (puerto 6543)
DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Cadena larga y aleatoria para firmar la cookie de sesión.
# Se puede generar con:  openssl rand -base64 32
SESSION_SECRET=cambia_esto_por_una_cadena_aleatoria
